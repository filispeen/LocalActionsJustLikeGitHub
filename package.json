{
  "name": "local-actions-just-like-github",
  "displayName": "Local Actions, Just Like GitHub",
  "description": "Run GitHub Actions workflows locally with a familiar GitHub Actions-style UI",
  "version": "0.1.0",
  "publisher": "filispeen",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "local-actions",
          "title": "Local Actions",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "local-actions": [
        {
          "id": "localActions.componentsView",
          "name": "Components"
        },
        {
          "id": "localActions.workflowsView",
          "name": "Workflows"
        }
      ]
    },
    "commands": [
      {
        "command": "localActions.openActionsPage",
        "title": "Open Actions Page",
        "category": "Local Actions"
      },
      {
        "command": "localActions.refreshComponents",
        "title": "Refresh Components",
        "category": "Local Actions",
        "icon": "$(refresh)"
      },
      {
        "command": "localActions.openActInstallGuide",
        "title": "Install Guidance for act",
        "category": "Local Actions"
      },
      {
        "command": "localActions.openDockerGuide",
        "title": "Docker Guidance",
        "category": "Local Actions"
      },
      {
        "command": "localActions.refreshWorkflows",
        "title": "Refresh Workflows",
        "category": "Local Actions",
        "icon": "$(refresh)"
      },
      {
        "command": "localActions.openWorkflowFile",
        "title": "Open Workflow File",
        "category": "Local Actions",
        "icon": "$(go-to-file)"
      },
      {
        "command": "localActions.runWorkflow",
        "title": "Run Workflow",
        "category": "Local Actions",
        "icon": "$(play)"
      },
      {
        "command": "localActions.runJob",
        "title": "Run Job",
        "category": "Local Actions",
        "icon": "$(play)"
      },
      {
        "command": "localActions.runWorkflowWithInputs",
        "title": "Run with Inputs...",
        "category": "Local Actions",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "localActions.refreshComponents",
          "when": "view == localActions.componentsView",
          "group": "navigation"
        },
        {
          "command": "localActions.refreshWorkflows",
          "when": "view == localActions.workflowsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "localActions.openWorkflowFile",
          "when": "view == localActions.workflowsView && (viewItem == workflowItem || viewItem == invalidWorkflowItem || viewItem == jobItem)",
          "group": "inline"
        },
        {
          "command": "localActions.runWorkflow",
          "when": "view == localActions.workflowsView && viewItem == workflowItem",
          "group": "inline"
        },
        {
          "command": "localActions.runWorkflowWithInputs",
          "when": "view == localActions.workflowsView && (viewItem == workflowItem || viewItem == jobItem)",
          "group": "inline"
        },
        {
          "command": "localActions.runJob",
          "when": "view == localActions.workflowsView && viewItem == jobItem",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Local Actions",
      "properties": {
        "localActions.actPath": {
          "type": "string",
          "default": "act",
          "description": "Path to the act executable"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:integration": "node test/integration/runTest.mjs",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@primer/css": "^21.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.6"
  }
}
